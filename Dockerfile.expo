# Dockerfile.expo
FROM node:22-alpine

WORKDIR /app

# מעתיקים רק את package.json (בלי ה-lock) כדי למנוע נעילה על גרסאות ישנות
COPY client/package.json ./

# 1. התקנה בסיסית + כל החבילות שהיו חסרות (הוספתי את image-picker)
RUN npm install && \
    npm install expo-sharing expo-file-system expo-document-picker expo-image-picker

# 2. תיקון הגרסה כדי להעלים את האזהרה הצהובה בטלפון
RUN npm install react-native@0.81.5

# 3. התקנת ngrok לחיבור יציב
RUN npm install @expo/ngrok

# העתקת שאר הקבצים
COPY client/ .

# הגדרת משתני סביבה
ENV REACT_NATIVE_PACKAGER_HOSTNAME="192.168.1.142" 

EXPOSE 8081 19000 19001 19002

# 4. נשארים עם Tunnel כי זה מה שעבד לך בוודאות
CMD ["npx", "expo", "start", "--tunnel", "-c"]